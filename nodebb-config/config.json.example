{
  "url": "https://yourdomain.com/community",
  "secret": "REPLACE_WITH_NODEBB_APP_SECRET",
  "relative_path": "/community",
  "port": "4567",
  "bind_address": "0.0.0.0",
  "database": "mongo",
  "mongo": {
    "host": "mongo",
    "port": 27017,
    "username": "nodebb",
    "password": "REPLACE_WITH_MONGO_ROOT_PASSWORD",
    "database": "sub2api_forum"
  },
  "redis": {
    "host": "redis",
    "port": 6379,
    "password": "REPLACE_WITH_REDIS_PASSWORD"
  },
  "upload_path": "/usr/src/app/public/uploads",
  "bcrypt_rounds": 12,
  "default_locale": "zh-CN",
  "languages": ["zh-CN", "en-GB"],
  "log_level": "info",
  "sessionKey": "REPLACE_WITH_NODEBB_SESSION_KEY",
  "minify": ["js", "css"],
  "socket.io": {
    "transports": ["websocket", "polling"],
    "origins": "https://yourdomain.com:*"
  }
}
