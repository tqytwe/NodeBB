{
  "id": "nodebb-plugin-sub2api-sso",
  "name": "Sub2API SSO & Wallet Sync",
  "description": "OAuth2 SSO + wallet/VIP sync from Sub2API platform",
  "library": "library.js",
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "static:api.routes", "method": "addAPIRoutes" },
    { "hook": "filter:auth.init", "method": "getStrategy" },
    { "hook": "filter:config.get", "method": "appendConfig" },
    { "hook": "filter:user.profileMenu", "method": "addProfileMenu" },
    { "hook": "filter:admin.header.build", "method": "addAdminNav" }
  ],
  "scripts": [
    "static/lib/main.js"
  ],
  "scss": [
    "static/styles.scss"
  ],
  "templates": "templates",
  "languages": "languages",
  "defaultLang": "zh-CN",
  "dependencies": {
    "nodebb": "^4.0.0"
  }
}
