# ============================================
# Sub2API NodeBB Forum 部署环境变量
# 复制此文件为 .env 并填入实际值
# ============================================

# ============================================
# Sub2API 平台配置
# ============================================
SUB2API_PLATFORM_URL=https://yourdomain.com

# NodeBB OAuth2 客户端配置
NODEBB_SSO_CLIENT_ID=sub2api_forum
NODEBB_SSO_CLIENT_SECRET=REPLACE_WITH_32_BYTE_HEX

# 主平台 OAuth2 端点
NODEBB_SSO_AUTHORIZE_URL=https://yourdomain.com/api/v1/sso/oauth/authorize
NODEBB_SSO_TOKEN_URL=https://yourdomain.com/api/v1/sso/oauth/token
NODEBB_SSO_USERINFO_URL=https://yourdomain.com/api/v1/sso/oauth/userinfo

# Webhook HMAC 签名密钥(主平台 + NodeBB 必须一致)
NODEBB_WEBHOOK_SECRET=REPLACE_WITH_32_BYTE_HEX

# ============================================
# NodeBB 应用密钥(独立生成)
# ============================================
NODEBB_APP_SECRET=REPLACE_WITH_32_BYTE_HEX
NODEBB_SESSION_KEY=REPLACE_WITH_32_BYTE_HEX

# ============================================
# MongoDB
# ============================================
MONGO_ROOT_PASSWORD=REPLACE_WITH_32_BYTE_HEX

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=REPLACE_WITH_32_BYTE_HEX

# ============================================
# 备份配置
# ============================================
BACKUP_DIR=/opt/sub2api-forum/backups
BACKUP_KEEP_DAYS=30

# ============================================
# GitHub Actions (仅 CI 使用)
# ============================================
# SERVER_HOST=
# SERVER_USER=
# SSH_PRIVATE_KEY=
# SLACK_WEBHOOK=
