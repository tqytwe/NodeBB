# ============================================
# Sub2API NodeBB 论坛环境变量 (Zeabur 部署)
# 在 Zeabur 控制台 NodeBB 服务 → Environment Variables 配置
# ============================================

# Sub2API 平台地址
SUB2API_PLATFORM_URL=https://jisudeng.com

# NodeBB OAuth2 客户端配置
NODEBB_SSO_CLIENT_ID=sub2api_forum
NODEBB_SSO_CLIENT_SECRET=REPLACE_WITH_32_BYTE_HEX

# 主平台 OAuth2 端点
NODEBB_SSO_AUTHORIZE_URL=https://api.jisudeng.com/api/v1/sso/oauth/authorize
NODEBB_SSO_TOKEN_URL=https://api.jisudeng.com/api/v1/sso/oauth/token
NODEBB_SSO_USERINFO_URL=https://api.jisudeng.com/api/v1/sso/oauth/userinfo

# Webhook HMAC 签名密钥(主平台 + NodeBB 必须一致)
NODEBB_SSO_WEBHOOK_SECRET=REPLACE_WITH_32_BYTE_HEX

# ============================================
# 以下由 Zeabur 模板自动配置, 无需手动设置
# ============================================
# MONGO_CONNECTION_STRING  (Zeabur 自动注入)
# MONGO_HOST               (Zeabur 自动注入)
# MONGO_PORT               (Zeabur 自动注入)
# MONGO_USERNAME           (Zeabur 自动注入)
# MONGO_PASSWORD           (Zeabur 自动注入)
# REDIS_CONNECTION_STRING  (Zeabur 自动注入)
# REDIS_HOST               (Zeabur 自动注入)
# REDIS_PORT               (Zeabur 自动注入)
